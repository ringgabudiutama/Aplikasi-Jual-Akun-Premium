# Postgres connection string (Vercel Postgres / Neon).
# Vercel Storage -> Postgres -> Connect -> ".env.local" tab -> copy the value that
# starts with postgres:// and ends with ?sslmode=require
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Vercel Blob (Storage -> Blob -> Create -> copy token)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# Admin login password (choose your own, keep it secret)
ADMIN_PASSWORD="ganti-password-ini"

# Random 32+ char string used to sign the admin login cookie.
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET="ganti-dengan-string-acak-panjang"

# Full site URL (used for metadata / WA share links), no trailing slash
NEXT_PUBLIC_SITE_URL="https://riforapremium.vercel.app"
